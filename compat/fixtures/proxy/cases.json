    {
      "id": "proxy.glype.flow",
      "suite": "proxy",
      "kind": "glype",
      "request": {
        "operation": "glype",
        "session_headers": [
          {"name": "User-Agent", "value": "xeh-fixture/1"},
          {"name": "Accept", "value": "*/*"},
          {"name": "Accept-Charset", "value": "utf-8;q=0.7,*;q=0.7"},
          {"name": "Accept-Encoding", "value": "identity"},
          {"name": "Cookie", "value": "ipb_member_id=11; ipb_pass_hash=22; nw=1"}
        ],
        "targets": ["http://synthetic.invalid/page?q=a b&z=1"]
      },
      "glype": {
        "path": "/browse.php?u=x&b=4",
        "session_headers": [
          {"name": "User-Agent", "value": "xeh-fixture/1"},
          {"name": "Accept", "value": "*/*"},
          {"name": "Accept-Charset", "value": "utf-8;q=0.7,*;q=0.7"},
          {"name": "Accept-Encoding", "value": "identity"},
          {"name": "Cookie", "value": "ipb_member_id=11; ipb_pass_hash=22; nw=1"}
        ],
        "targets": ["http://synthetic.invalid/page?q=a b&z=1"],
        "responses": [
          {
            "status": 200,
            "headers": [
              ["Content-Type", "text/html; charset=utf-8"],
              ["Set-Cookie", "c[synthetic.invalid][/][a]=1; path=/"],
              ["Set-Cookie", "c[synthetic.invalid][/][b]=2; path=/"]
            ],
            "body_text": "see /browse.php?u=http%3A%2F%2Fsynthetic.invalid%2Fpage%3Fq%3Da+b%26z%3D1&b=4&f=norefer done"
          }
        ]
      },
      "assertions": {
        "/flows/0/url": "http://synthetic.invalid/page?q=a b&z=1",
        "/flows/0/content": "see http://synthetic.invalid/page?q=a+b&z=1",
        "/flows/0/set_cookie": "c[synthetic.invalid][/][a]=1;c[synthetic.invalid][/][b]=2;a=1;b=2",
        "/seen/0/headers/cookie": "c[synthetic.invalid][/][ipb_member_id]=11;c[synthetic.invalid][/][ipb_pass_hash]=22;c[synthetic.invalid][/][nw]=1",
        "/seen/0/headers/referer": "<glype>/browse.php",
        "/seen/0/path": "/browse.php?u=http%3A%2F%2Fsynthetic.invalid%2Fpage%3Fq%3Da+b%26z%3D1&b=4&f=norefer"
      }
    },
