          {"name": "Accept-Encoding", "value": "identity"},
          {"name": "Cookie", "value": "ipb_member_id=11"}
        ],
        "targets": ["http://a.invalid/1", "http://b.invalid/2"],
        "responses": [
          {"status": 200, "headers": [["Content-Type", "text/html"]], "body_text": "<input type=\"hidden\" name=\"action\" value=\"sslagree\">"},
          {"status": 302, "headers": [["Content-Type", "text/html"], ["Set-Cookie", "s=synthetic-session; path=/"]], "body_text": ""},
          {"status": 200, "headers": [["Content-Type", "text/html"]], "body_text": "first-ok"},
          {"status": 200, "headers": [["Content-Type", "text/html"]], "body_text": "second-ok"}
        ]
      },
      "assertions": {
        "/flows/0/content": "first-ok",
        "/flows/1/content": "second-ok",
        "/glyph_s": "synthetic-session",
        "/seen/2/headers/cookie": "c[a.invalid][/][ipb_member_id]=11;s=synthetic-session",
        "/seen/3/headers/cookie": "s=synthetic-session;c[b.invalid][/][ipb_member_id]=11"
      }
    },
