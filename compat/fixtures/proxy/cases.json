{
  "cases": [
    {
      "id": "proxy.pool.order-and-readd",
      "suite": "proxy",
      "kind": "pool",
      "request": {
        "operation": "pool",
        "steps": [
          {"op": "proxy_add", "address": "http://a.invalid:1"},
          {"op": "proxy_add", "address": "http://b.invalid:2"},
          {"op": "proxy_select", "now": 100.0},
          {"op": "proxy_not_good", "address": "http://a.invalid:1", "weight": 5, "expire": 0.0, "now": 100.0},
          {"op": "proxy_select", "now": 200.0},
          {"op": "proxy_has", "now": 200.0}
        ]
      },
      "assertions": {
        "/steps/0/proxy/order": ["http://a.invalid:1"],
        "/steps/1/proxy/order": ["http://a.invalid:1", "http://b.invalid:2"],
        "/steps/3/proxy/disabled": {"http://a.invalid:1": 100.0},
        "/steps/4/error": "RuntimeError",
        "/steps/4/proxy/disabled": {},
        "/steps/5/value": "{\"value\":false}"
      }
    },
    {
      "id": "proxy.pool.trace-scores",
      "suite": "proxy",
      "kind": "pool",
      "request": {
        "operation": "pool",
        "steps": [
          {"op": "proxy_add", "address": "http://a.invalid:1"},
          {"op": "proxy_trace", "address": "http://a.invalid:1", "outcome": "success", "weight": 2, "now": 100.0},
          {"op": "proxy_trace", "address": "http://a.invalid:1", "outcome": "success", "weight": 1, "check_present": true, "check_ok": false, "now": 100.0},
          {"op": "proxy_trace", "address": "http://a.invalid:1", "outcome": "exception", "weight": 1, "exception_class": "ConnectionError", "detail": "boom", "now": 100.0},
          {"op": "proxy_trace", "address": "http://a.invalid:1", "outcome": "exception", "weight": 5, "exception_class": "ConnectionError", "detail": "BadStatusLine: bad", "now": 100.0},
          {"op": "proxy_trace", "address": "http://a.invalid:1", "outcome": "success", "weight": 1, "now": 100.0},
          {"op": "proxy_trace", "address": "http://a.invalid:1", "outcome": "exception", "weight": 3, "exception_class": "ProxyError", "detail": "proxy", "now": 100.0},
          {"op": "proxy_select", "now": 500.0},
          {"op": "proxy_has", "now": 500.0}
        ]
      },
      "assertions": {
        "/steps/1/proxy/counts": {"http://a.invalid:1": [2, 0]},
        "/steps/2/proxy/counts": {"http://a.invalid:1": [2, 1]},
        "/steps/3/proxy/counts": {"http://a.invalid:1": [2, 2]},
        "/steps/4/proxy/counts": {"http://a.invalid:1": [2, 7]},
        "/steps/4/proxy/disabled": {"http://a.invalid:1": 0},
        "/steps/6/proxy/disabled": {"http://a.invalid:1": 0},
        "/steps/7/error": "PoolException",
        "/steps/8/value": "{\"value\":true}"
      }
    },
