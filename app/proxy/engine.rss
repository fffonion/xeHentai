//! Thin proxy test façade over the application's retained pool owner.
//!
//! Pool operations are dispatched through `app/domain/state.rss`, so the store
//! (not a demo pool rebuilt per call) carries counters, disables and the pool's
//! creation state across every step. Policy cases call the same functions the
//! application uses. The glype scenario operation is closed; retained Glype
//! exchange is `proxy_request` on the task owner.
use json;
use xeh_proxy;

use super::domain::state;
use self::policy;
use self::pool;
use self::worker;

fn field_string(document: map, name: string, fallback: string) -> string {
    if document.has(name) && type(document[name].copy()) == "string" => {
        let typed: string = document[name].copy();
        typed
    } else => {
        fallback
    }
}

fn field_maps(document: map, name: string) -> [map] {
    if document.has(name) && type(document[name].copy()) == "array" => {
        let typed: [map] = document[name].copy();
        typed
    } else => {
        []
    }
}

fn field_strings(document: map, name: string) -> [string] {
    if document.has(name) && type(document[name].copy()) == "array" => {
        let typed: [string] = document[name].copy();
        typed
    } else => {
        []
    }
}

fn join(items: [string]) -> string {
    let mut output = "";
    for index in 0..items.length {
        if index > 0 {
            output = output + ",";
        }
        output = output + items[index].copy();
    }
    output
}

fn run_pool(document: map) -> string {
    let steps: [map] = field_maps(document.copy(), "steps");
    let mut control = state::create([], 0, false);
    let mut results: [string] = [];
    for index in 0..steps.length {
        let step: map = steps[index].copy();
        control = state::dispatch(control, json::encode(step.copy()));
        let report: map = json::decode::<map>(state::report(control.copy()));
        let op: string = step["op"].copy();
        let ok: bool = report["ok"].copy();
        let error: string = report["error"].copy();
        let mut code_text = "null";
        if type(report["code"].copy()) != "null" {
            let code: int = report["code"].copy();
            code_text = json::encode(code);
        }
        let mut value_text = "null";
        if type(report["value"].copy()) != "null" {
            let value: string = report["value"].copy();
            value_text = json::encode(value);
        }
        let mut proxy_text = "null";
        if type(report["proxy"].copy()) != "null" {
            let proxy_state: map = report["proxy"].copy();
            proxy_text = json::encode(proxy_state);
        }
        // Source `proxied_request` publishes the selected address on the step.
        // The route object inside `value` is additional and does not replace it.
        let mut address_text = "null";
        if op == "proxy_select" && ok && type(report["value"].copy()) != "null" {
            let selected_text: string = report["value"].copy();
            let selected: map = json::decode::<map>(selected_text);
            if selected.has("address") && type(selected["address"].copy()) == "string" {
                let address: string = selected["address"].copy();
                address_text = json::encode(address);
            }
        }
        results[results.length] = "{\"index\":" + json::encode(index)
            + ",\"op\":" + json::encode(op)
            + ",\"ok\":" + json::encode(ok)
            + ",\"error\":" + json::encode(error)
            + ",\"code\":" + code_text
            + ",\"value\":" + value_text
            + ",\"address\":" + address_text
            + ",\"proxy\":" + proxy_text + "}";
    }
    "{\"operation\":\"pool\",\"steps\":[" + join(results) + "]}"
}

fn bool_field(document: map, name: string, fallback: bool) -> bool {
    if document.has(name) && type(document[name].copy()) == "bool" => {
        let typed: bool = document[name].copy();
        typed
    } else => {
        fallback
    }
}

fn policy_map(config: map, urls: [string]) -> string {
    let image = bool_field(config.copy(), "proxy_image", false);
    let image_only = bool_field(config.copy(), "proxy_image_only", false);
    let mut rows: [string] = [];
    for index in 0..urls.length {
        let url: string = urls[index].copy();
        let webpage = policy::matches(image, image_only, url.copy());
        let all = policy::matches(true, false, url.copy());
        let image_row = policy::matches(false, true, url.copy());
        rows[rows.length] = "{\"url\":" + json::encode(url)
            + ",\"webpage\":" + json::encode(webpage)
            + ",\"all\":" + json::encode(all)
            + ",\"image_only\":" + json::encode(image_row) + "}";
    }
    "{\"operation\":\"policy\",\"urls\":[" + join(rows) + "]}"
}

fn run_policy(document: map) -> string {
    let config = if document.has("config") && type(document["config"].copy()) == "map" => {
        let value: map = document["config"].copy();
        value
    } else => {
        let empty: map = {};
        empty
    };
    policy_map(config, field_strings(document, "urls"))
}

fn run_routes(document: map) -> string {
    let addresses: [string] = field_strings(document.copy(), "addresses");
    let mut rows: [string] = [];
    for index in 0..addresses.length {
        let address: string = addresses[index].copy();
        let route_map = pool::route_for(address.copy());
        rows[rows.length] = "{\"address\":" + json::encode(address)
            + ",\"route\":" + json::encode(route_map) + "}";
    }
    "{\"operation\":\"routes\",\"routes\":[" + join(rows) + "]}"
}

fn run_worker(document: map) -> string {
    let url = field_string(document.copy(), "url", "");
    let method = field_string(document.copy(), "method", "GET");
    let data = field_string(document.copy(), "data", "");
    let explicit = bool_field(document.copy(), "explicit_allow_redirects", false);
    let agreement = field_string(document.copy(), "agreement_url", "");
    let image = bool_field(document.copy(), "proxy_image", false);
    let image_only = bool_field(document.copy(), "proxy_image_only", false);
    let report = worker::request(url, method, data, explicit, agreement, image, image_only);
    let ok: bool = report["ok"].copy();
    let exception: string = report["exception"].copy();
    let detail: string = report["detail"].copy();
    let logical_url: string = report["logical_url"].copy();
    let real_url: string = report["real_url"].copy();
    let final_url: string = report["final_url"].copy();
    let status: int = report["status"].copy();
    let byte_length: int = report["byte_length"].copy();
    let hops: [map] = report["hops"].copy();
    let mut hop_texts: [string] = [];
    for index in 0..hops.length {
        let hop: map = hops[index].copy();
        let hop_url: string = hop["url"].copy();
        let proxied: bool = hop["proxied"].copy();
        let hop_status: int = hop["status"].copy();
        let hop_error: string = hop["error_kind"].copy();
        hop_texts[hop_texts.length] = "{\"url\":" + json::encode(hop_url)
            + ",\"proxied\":" + json::encode(proxied)
            + ",\"status\":" + json::encode(hop_status)
            + ",\"error_kind\":" + json::encode(hop_error) + "}";
    }
    "{\"operation\":\"worker\",\"ok\":" + json::encode(ok)
        + ",\"exception\":" + json::encode(exception)
        + ",\"detail\":" + json::encode(detail)
        + ",\"logical_url\":" + json::encode(logical_url)
        + ",\"real_url\":" + json::encode(real_url)
        + ",\"final_url\":" + json::encode(final_url)
        + ",\"status\":" + json::encode(status)
        + ",\"byte_length\":" + json::encode(byte_length)
        + ",\"hops\":[" + join(hop_texts) + "]}"
}

fn run_transfer(document: map) -> string {
    let url = field_string(document.copy(), "url", "");
    let method = field_string(document.copy(), "method", "GET");
    let data = field_string(document.copy(), "data", "");
    let relative = field_string(document.copy(), "stage", "");
    let names: [string] = [];
    let values: [string] = [];
    let response = xeh_proxy::exchange(
        url.copy(),
        method.copy(),
        names,
        values,
        data.copy(),
        "direct",
        "",
        0,
        false,
        false,
        true,
        0
    );
    let status: int = response.status;
    let byte_length: int = response.byte_length;
    let body_text: string = response.body_text;
    let error_kind: string = response.error_kind;
    let staged = xeh_proxy::body_stage(response.body, relative.copy());
    let staged_ok: bool = staged["ok"].copy();
    let staged_bytes: int = staged["bytes"].copy();
    let staged_error: string = staged["error"].copy();
    let _closed = xeh_proxy::body_close(response.body);
    "{\"operation\":\"transfer\",\"status\":" + json::encode(status)
        + ",\"byte_length\":" + json::encode(byte_length)
        + ",\"body_text\":" + json::encode(body_text)
        + ",\"error_kind\":" + json::encode(error_kind)
        + ",\"staged_ok\":" + json::encode(staged_ok)
        + ",\"staged_bytes\":" + json::encode(staged_bytes)
        + ",\"staged_error\":" + json::encode(staged_error) + "}"
}

pub fn run_scenario(request: string) -> string {
    let document: map = json::decode::<map>(request);
    let operation = field_string(document.copy(), "operation", "");
    if operation == "pool" => {
        run_pool(document)
    } else if operation == "policy" => {
        run_policy(document)
    } else if operation == "routes" => {
        run_routes(document)
    } else if operation == "glype" => {
        "{\"operation\":\"glype\",\"ok\":false,\"error\":\"glype_exchange_closed\"}"
    } else if operation == "worker" => {
        run_worker(document)
    } else if operation == "transfer" => {
        run_transfer(document)
    } else => {
        "{\"operation\":\"unknown\",\"error\":\"unknown_operation\"}"
    }
}
