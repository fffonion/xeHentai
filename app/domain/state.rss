    let staged_bytes: int = result["staged_bytes"].copy();
    let staged_error: string = result["staged_error"].copy();
    let glyph_s: string = result["glyph_s"].copy();
    let epoch: int = result["epoch"].copy();
    let sent_cookie: string = result["sent_cookie"].copy();
    let logical_url: string = result["logical_url"].copy();
    let final_url: string = result["final_url"].copy();
    let real_url: string = result["real_url"].copy();
