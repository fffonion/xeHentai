fn json_starts(value_json: string, marker: string) -> bool {
    let length = (&value_json).length;
    length > 0 && (&value_json)[0:1] == marker
}

fn queue_elements_are_strings(values: array, index: int) -> bool {
    let mut current = index;
    let mut ok = true;
    while current < values.length && ok {
        if type(values[current].copy()) == "string" {
            current = current + 1;
        } else {
            ok = false;
        }
    }
    ok
}

/// Structural checks the upstream would hit at `from_dict` / `to_dict` time.
/// Every accepted value is exactly what the typed record can carry; a safe
/// refusal is reported instead of a half-applied table.
fn task_shape_error(value_json: string, outer_key: string) -> string {
    let mut error = "";
    if json_starts(value_json.copy(), "{") == false {
        error = "type:task";
    } else {
        let object: map = json::decode::<map>(value_json);
        if object.has("guid") == false {
            error = "missing_guid";
        } else if type(object["guid"].copy()) != "string" {
            error = "type:guid";
        } else if object.has("url") && type(object["url"].copy()) != "string" {
            error = "type:url";
        } else if object.has("state") && type(object["state"].copy()) != "int" {
            error = "type:state";
        } else if object.has("failcode") && type(object["failcode"].copy()) != "int" {
            error = "type:failcode";
        } else if object.has("config") && type(object["config"].copy()) != "map" {
            error = "type:config";
        } else if object.has("meta") && type(object["meta"].copy()) != "map" {
            error = "type:meta";
        } else if object.has("reload_map") && type(object["reload_map"].copy()) != "map" {
            error = "type:reload_map";
        } else if object.has("duplicate_map") && type(object["duplicate_map"].copy()) != "map" {
            error = "type:duplicate_map";
        } else if object.has("renamed_map") && type(object["renamed_map"].copy()) != "map" {
            error = "type:renamed_map";
        } else if object.has("img_q") && type(object["img_q"].copy()) != "null" {
            if type(object["img_q"].copy()) != "array" {
                error = "type:img_q";
            } else {
                let values: array = object["img_q"].copy();
                if queue_elements_are_strings(values, 0) == false {
                    error = "type:img_q";
                }
            }
        }
        if error == "" && object.has("page_q") && type(object["page_q"].copy()) != "null" {
            if type(object["page_q"].copy()) != "array" {
                error = "type:page_q";
            } else {
                let values: array = object["page_q"].copy();
                if queue_elements_are_strings(values, 0) == false {
                    error = "type:page_q";
                }
            }
        }
        if error == "" && object.has("guid") {
            let guid: string = object["guid"].copy();
            if (&guid).length == 0 {
                error = "type:guid";
            }
        }
    }
    error
}

fn queue_text(object: map, name: string) -> string? {
    let mut result: string? = null;
    if object.has(name) && type(object[name].copy()) != "null" {
        let values: [string] = object[name].copy();
        if values.length > 0 {
            result = json::encode(values);
        }
    }
    result
}

fn record_from_text(value_json: string) -> Task {
    let object: map = json::decode::<map>(value_json);
    let url = field_string(object.copy(), "url", "");
    let gid_value: string? = if (&url).length > 0 => {
        task::url_gid(url.copy())
    } else => {
        null
    };
    let sethash_value: string? = if (&url).length > 0 => {
        task::url_sethash(url.copy())
    } else => {
        null
    };
    {
        url: url,
        gid: gid_value,
        sethash: sethash_value,
        guid: field_string(object.copy(), "guid", ""),
        state: field_int(object.copy(), "state", state_waiting()),
        failcode: field_int(object.copy(), "failcode", 0),
        config: field_map(object.copy(), "config"),
        meta: field_map(object.copy(), "meta"),
        reload_map: field_map(object.copy(), "reload_map"),
        duplicate_map: field_map(object.copy(), "duplicate_map"),
        renamed_map: field_map(object.copy(), "renamed_map"),
        img_q: queue_text(object.copy(), "img_q"),
        page_q: queue_text(object.copy(), "page_q"),
