//! RSS-owned task control: record, table, ready queue, incarnations, commands.
//!
//! The store is a real RustScript value. The embedding threads the returned
//! control root into the next owner invocation, so the table, configuration,
//! queue, epochs, and counters survive across commands without encoding the
//! store as JSON text and without rebuilding an empty store per call.
//!
//! Task control and the ready queue are owned here. Prepared tickets carry an
//! immutable guid, epoch, and kind. Pause, delete, resume, and a terminal
//! collision all advance the task's epoch, so an old ticket or completion
//! event can no longer change state, reopen a task, or add a completion.
//!
//! Two RustScript details shape this module:
//!
//! - Named struct types are resolved per module, so the task record, the
//!   store, and the command steps share this module. A record declared in a
//!   sibling module could not be used as a field or parameter type here.
//! - Reading a non-scalar struct field moves it out of the record. Every
//!   reader below therefore takes a copy-consuming accessor or passes
//!   `value.copy()`, and only linear helpers move the store as a whole.
//!
//! The global 25-key configuration crosses as parsed Core map data from its
//! single owner in `app/config/types.rss`.
use io;
use json;

use self::queue;
use self::session;
use self::task;
use super::config::types;
use super::proxy::pool;
use super::proxy::request;
use super::site::login;
use xeh_fs;
use xeh_system;

/// Largest epoch the JSON wire represents exactly. Advancing past it fails
/// closed; epochs never wrap into a reusable value.
fn max_epoch() -> int {
    9007199254740991
}

// Public task states, unchanged from `const.py`: paused 0, waiting 1,
// get_meta 2, scan_page 3, scan_img 4, scan_archive 5, download 10,
// make_archive 19, finished 20, failed -1. Error codes keep their original
// values: 0, 1000, 1001, 1101, 1105, 1106, 1107.
fn state_paused() -> int {
    0
}

fn state_waiting() -> int {
    1
}

fn state_finished() -> int {
    20
}

fn state_failed() -> int {
    -1
}

fn err_no_error() -> int {
    0
}

fn err_url_not_recognized() -> int {
    1000
}

fn err_cant_download_exh() -> int {
    1001
}

fn err_task_not_found() -> int {
    1101
}

fn err_delete_running_task() -> int {
    1105
}

fn err_task_cannot_pause() -> int {
    1106
}

fn err_task_cannot_resume() -> int {
    1107
}

/// `ERR_SAVE_SESSION_FAILED`.
fn err_save_session_failed() -> int {
    1103
}

/// The stored task record.
///
/// `img_q` / `page_q` carry the exact JSON array text of a non-empty queue, or
/// `null` when absent/empty. The upstream `to_dict()` only writes a queue that
/// is truthy, and `from_dict()` copies a falsy value as-is, so a raw-value
/// carrier keeps `null`, `[]` and non-empty lists distinguishable without
/// pretending an unordered map iteration is the record order.
struct Task {
    url: string,
    gid: string?,
    sethash: string?,
    guid: string,
    state: int,
    failcode: int,
    config: map,
    meta: map,
    reload_map: map,
    duplicate_map: map,
    renamed_map: map,
    img_q: string?,
    page_q: string?,
}

/// Ordered cookie state. `nw=1` is the upstream constructor default; loading a
/// session updates existing names in place and appends new ones, so the header
/// order is observable. `cookie_header` stays `null` until a document or the
/// legacy file has been merged, matching the upstream constructor.
struct CookieState {
    names: [string],
    values: map,
    header: string?,
}

struct Store {
    config: map,
    /// Upstream `Core.proxy`: `null` until a truthy proxy update creates the
    /// pool. Survives configuration updates, task commands and owner calls.
    proxy: map?,
    tasks: map,
    order: [string],
    queue: [string],
    epochs: map,
    completions: map,
    epoch_seq: int,
    has_login: bool,
    guid_plan: [string],
    guid_cursor: int,
    allow_seed: bool,
    cookies: CookieState,
    /// Per-controller owner nonce. Never serialized into `h.json`.
    owner_nonce: string,
    /// Private `_flist_done` observations: guid -> JSON array of finished ids.
    scan_done: map,
}

struct Control {
    store: Store,
    report: string,
}

struct EventCheck {
    accepted: bool,
    reason: string,
}

struct PendingEffect {
    kind: string,
    guid: string,
    directory: string,
    title: string,
}

struct Step {
    store: Store,
    ok: bool,
    error: string,
    code: int?,
    value: string?,
    warnings: [string],
    event: EventCheck?,
    pending: PendingEffect?,
    presence: map?,
    session: SessionCheck?,
}

/// Observable session effect of one save/load command.
///
/// `code`/`value` mirror the upstream `(code, value)` return; `error` is the
/// RSS-side refusal class when upstream would have raised outside the JSON
/// parse handler. `cookies` is rendered as an ordered array so a JSON object
/// comparison cannot hide a reordered Cookie header.
struct SessionCheck {
    code: int?,
    value: string?,
    error: string,
    committed: bool,
    directory_synced: bool,
}

struct SessionTaskEntry {
    key: string,
    value_json: string,
}

struct SessionCookieEntry {
    key: string,
    value_json: string,
}

struct SessionPlan {
    ok: bool,
    error: string?,
    tasks: [SessionTaskEntry]?,
    cookies: [SessionCookieEntry]?,
}

struct ScanPlan {
    ok: bool,
    error: string?,
    detail: string?,
    meta: map?,
    finished: int?,
    done: [int]?,
}

struct RemainingItem {
    fid: int,
    url: string,
    renamed: string,
    file: string,
    staging: string,
}

struct RemainingPlan {
    ok: bool,
    error: string?,
    items: [RemainingItem]?,
}

struct CookieHeaderPlan {
    ok: bool,
    header: string?,
    error: string?,
    name: string?,
}

struct LegacyPlan {
    ok: bool,
    ignored: bool?,
    member: string?,
    pass: string?,
}

// ---- task record -----------------------------------------------------------

/// `Task.__init__`: waiting, no failure, empty maps, no queues yet.
fn make_task(url: string, cfg: map, guid: string) -> Task {
    {
        url: url.copy(),
        gid: task::url_gid(url.copy()),
        sethash: task::url_sethash(url),
        guid: guid,
        state: state_waiting(),
        failcode: 0,
        config: cfg,
        meta: {},
        reload_map: {},
        duplicate_map: {},
        renamed_map: {},
        img_q: null,
        page_q: null,
    }
}

/// `Task.set_fail`: failed state, saved code, and only `meta` is cleared.
fn set_fail(record: Task, code: int) -> Task {
    let mut next = record.copy();
    next.state = state_failed();
    next.failcode = code;
    next.meta = {};
    next
}

/// `Task.cleanup`. A terminal record drops its queues and reload map. The
/// `before_delete` branch only removes downloaded files upstream; that effect
/// belongs to the Task10 file owner and is not performed here.
fn cleanup(record: Task, before_delete: bool) -> Task {
    let mut next = record.copy();
    let state = record_state(record.copy());
    if before_delete => {
        // No file effect in this scope. Callers must not report a completed
        // physical removal.
        next
    } else => {
        if state == state_finished() || state == state_failed() {
            next.img_q = null;
            next.page_q = null;
            next.reload_map = {};
        }
        next
    }
}

fn record_state(record: Task) -> int {
    record.state
}

fn record_title(record: Task) -> string {
    record.meta["title"].copy()
}

fn record_directory(record: Task) -> string {
    let cfg = record.config.copy();
    if cfg.has("dir") => {
        let typed: string = cfg["dir"].copy();
        typed
    } else => {
        ""
    }
}

fn delete_needs_files(record: Task) -> bool {
    let cfg = record.config.copy();
    task::config_flag(cfg, "delete_task_files", false) && record.meta.has("title")
}

/// `Task.to_dict()` order: insertion order, never sorted. Fields that the
/// upstream dict comprehension omits (absent ids, falsy queues) stay absent.
fn task_text(record: Task) -> string {
    let mut entries = [];
    entries[entries.length] = {
        key: "url",
        value_json: json::encode(record.url.copy()),
    };
    if type(record?.gid) != "null" {
        entries[entries.length] = {
            key: "gid",
            value_json: json::encode(record?.gid.unwrap_or("")),
        };
    }
    if type(record?.sethash) != "null" {
        entries[entries.length] = {
            key: "sethash",
            value_json: json::encode(record?.sethash.unwrap_or("")),
        };
    }
    entries[entries.length] = {
        key: "failcode",
        value_json: json::encode(record.failcode),
    };
    entries[entries.length] = {
        key: "state",
        value_json: json::encode(record.state),
    };
    entries[entries.length] = {
        key: "guid",
        value_json: json::encode(record.guid.copy()),
    };
    entries[entries.length] = {
        key: "config",
        value_json: json::encode(record.config.copy()),
    };
    entries[entries.length] = {
        key: "meta",
        value_json: json::encode(record.meta.copy()),
    };
    entries[entries.length] = {
        key: "reload_map",
        value_json: json::encode(record.reload_map.copy()),
    };
    entries[entries.length] = {
        key: "duplicate_map",
        value_json: json::encode(record.duplicate_map.copy()),
    };
    entries[entries.length] = {
        key: "renamed_map",
        value_json: json::encode(record.renamed_map.copy()),
    };
    if type(record?.img_q) != "null" {
        entries[entries.length] = {
            key: "img_q",
            value_json: record?.img_q.unwrap_or(""),
        };
    }
    if type(record?.page_q) != "null" {
        entries[entries.length] = {
            key: "page_q",
            value_json: record?.page_q.unwrap_or(""),
        };
    }
    json::encode_object_entries(entries)
}

fn table_json(tasks: map, order: [string]) -> string {
    let mut out = "[";
    let mut count = 0;
    for index in 0..order.length {
        let guid: string = order[index].copy();
        if tasks.has(guid) {
            let record: Task = tasks[guid].copy();
            if count > 0 {
                out = out + ",";
            }
            out = out + task_text(record);
            count = count + 1;
        }
    }
    out + "]"
}

// ---- request field readers -------------------------------------------------

fn field_string(document: map, name: string, fallback: string) -> string {
    if document.has(name) && type(document[name].copy()) == "string" => {
        let typed: string = document[name].copy();
        typed
    } else => {
        fallback
    }
}

fn field_int(document: map, name: string, fallback: int) -> int {
    if document.has(name) && type(document[name].copy()) == "int" => {
        let typed: int = document[name].copy();
        typed
    } else => {
        fallback
    }
}

fn field_number(document: map, name: string, fallback: number) -> number {
    if document.has(name) && (type(document[name].copy()) == "float" || type(document[name].copy()) == "int") => {
        let typed: number = document[name].copy();
        typed
    } else => {
        fallback
    }
}

fn field_bool(document: map, name: string, fallback: bool) -> bool {
    if document.has(name) && type(document[name].copy()) == "bool" => {
        let typed: bool = document[name].copy();
        typed
    } else => {
        fallback
    }
}

fn field_map(document: map, name: string) -> map {
    if document.has(name) && type(document[name].copy()) == "map" => {
        let typed: map = document[name].copy();
        typed
    } else => {
        {}
    }
}

fn has_int(document: map, name: string) -> bool {
    document.has(name) && type(document[name].copy()) == "int"
}

