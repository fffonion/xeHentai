        store: store,
        ok: true,
        error: "",
        code: null,
        value: null,
        warnings: [],
        event: null,
        pending: null,
        presence: null,
        session: null,
    }
}

fn code_step(store: Store, code: int, value: string?) -> Step {
    {
        store: store,
        ok: true,
        error: "",
        code: code,
        value: value,
        warnings: [],
        event: null,
        pending: null,
        presence: null,
        session: null,
    }
}

fn error_step(store: Store, error: string) -> Step {
    {
        store: store,
        ok: false,
        error: error,
        code: null,
        value: null,
        warnings: [],
        event: null,
