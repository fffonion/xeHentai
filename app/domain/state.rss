}

fn session_save(store: Store) -> Step {
    let paths = xeh_fs::session_paths();
    let save_tasks = task::config_flag(store.config.copy(), "save_tasks", false);
    let mut texts: [string] = [];
    for index in 0..store.order.length {
        let guid: string = store.order[index].copy();
        if store.tasks.has(guid) {
            let record: Task = store.tasks[guid].copy();
            texts[texts.length] = task_text(record);
        }
    }
    let document_text = session::session_document(
        store.order.copy(),
        texts,
        save_tasks,
        store.cookies.names.copy(),
        store.cookies.values.copy()
    );
    let written = xeh_fs::write_atomic(paths.session_path.copy(), document_text);
    let error_text = if type(written.error) == "null" => {
        ""
    } else => {
        "session write failed"
    };
    if written.committed.copy() == false => {
        let value = if error_text == "" => {
            "session write failed"
        } else => {
            error_text
        };
        session_step(
            store,
            false,
            "session:write_failed",
            err_save_session_failed(),
            value,
            false,
            false
        )
    } else => {
        let directory_synced = written.directory_synced.copy();
        let mut step = session_step(
            store,
            true,
            "",
            err_no_error(),
            null,
            true,
            directory_synced
        );
        if directory_synced == false && error_text != "" {
            let mut warnings = step.warnings;
            warnings[warnings.length] = "session_directory_sync_failed";
            step.warnings = warnings;
        }
        step
    }
}

/// Pre-checks the aggregate scan budget before any stat, zero-file removal or
/// Root publication. `meta.total` is the number of fids `scan_task` walks; the
/// budget belongs to the trusted `SessionOptions` and is never raised by the
/// imported document. A negative, overflowing or over-budget total is a stable
/// `scan_budget` refusal.
fn scan_budget_error(entries: [SessionTaskEntry], budget: int) -> string {
    let mut total: int = 0;
    let mut error = "";
    for index in 0..entries.length {
        if error == "" {
            let entry: SessionTaskEntry = entries[index].copy();
            let value_json: string = entry.value_json;
            let shape = task_shape_error(value_json.copy(), entry.key.copy());
            if shape != "" {
                error = "session:" + shape;
            } else {
                let object: map = json::decode::<map>(value_json);
                if object.has("meta") {
                    let meta: map = object["meta"].copy();
                    if meta.has("filelist") {
                        if meta.has("total") == false {
                            error = "session:scan:missing_total";
                        } else if type(meta["total"].copy()) != "int" {
                            error = "session:scan:type:total";
                        } else {
                            let count: int = meta["total"].copy();
                            if count < 0 || budget < 0 || total > budget || count > budget - total {
                                error = "session:scan_budget";
                            } else {
                                total = total + count;
                            }
                        }
                    }
                }
            }
        }
    }
    error
}

fn session_load(store: Store) -> Step {
    let paths = xeh_fs::session_paths();
    let session_path = paths.session_path.copy();
    let legacy_path = paths.legacy_cookie_path.copy();
    let session_present = paths.session_exists.copy();
    let session_size = paths.session_size.copy();
    let max_session_bytes = paths.max_session_bytes.copy();
    let legacy_present = paths.legacy_exists.copy();
    let scan_budget = paths.scan_budget.copy();
    let mut next = store.copy();
    let mut error = "";
    let mut cookies = store.cookies.copy();
    let mut has_login = store.has_login.copy();
    if session_present && session_size > max_session_bytes {
        error = "session:read_limit";
    }
    if session_present && error == "" {
        let text = read_text(session_path.copy());
        let plan_text = session::parse_session(text);
        let plan: SessionPlan = json::decode::<SessionPlan>(plan_text);
        if plan.ok.copy() == false {
            error = "session:" + plan.copy()?.error.unwrap_or("invalid_document");
        } else {
            let no_tasks: [SessionTaskEntry] = [];
            let no_cookies: [SessionCookieEntry] = [];
            let task_entries = plan.copy()?.tasks.unwrap_or(no_tasks);
            let cookie_entries = plan.copy()?.cookies.unwrap_or(no_cookies);
            for index in 0..cookie_entries.length {
                let entry: SessionCookieEntry = cookie_entries[index].copy();
                let value_json: string = entry.value_json;
                let name: string = entry.key;
                if json_starts(value_json.copy(), "\"") == false {
                    error = "session:cookie_value_not_string";
                } else if error == "" {
                    let value: string = json::decode::<string>(value_json);
                    cookies = cookie_set(cookies, name, value);
                }
            }
            if error == "" {
                let header_plan: CookieHeaderPlan = json::decode::<CookieHeaderPlan>(
                    login::cookie_header(cookies.names.copy(), cookies.values.copy())
                );
                if header_plan.ok.copy() == false {
                    error = "session:cookie_value_not_string";
                } else {
                    cookies.header = header_plan.copy()?.header;
                    has_login = login::has_login(cookies.names.copy());
                }
            }
            if error == "" {
                let budget_error = scan_budget_error(task_entries.copy(), scan_budget.copy());
                if budget_error != "" {
                    error = budget_error;
                }
            }
            let mut records: [Task] = [];
            let mut done_texts: [string] = [];
            for index in 0..task_entries.length {
                let entry: SessionTaskEntry = task_entries[index].copy();
                let outer_key: string = entry.key;
                let value_json: string = entry.value_json;
                if error == "" {
                    let shape = task_shape_error(value_json.copy(), outer_key.copy());
                    if shape != "" {
                        error = "session:" + shape;
                    } else {
                        let mut record: Task = record_from_text(value_json);
                        let mut done_text = "[]";
                        if record.meta.copy().has("filelist") {
                            let scan_plan: ScanPlan = json::decode::<ScanPlan>(
                                session::scan_task(
                                    json::encode(record.config.copy()),
                                    json::encode(record.meta.copy())
                                )
                            );
                            if scan_plan.ok.copy() == false {
                                let class = scan_plan.copy()?.error.unwrap_or("scan_failed");
                                error = "session:scan:" + class;
                            } else {
                                let meta_map: map = scan_plan.copy()?.meta.unwrap_or({});
                                record.meta = meta_map;
                                let no_done: [int] = [];
                                let done_values: [int] = scan_plan.copy()?.done.unwrap_or(no_done);
                                done_text = json::encode(done_values);
                            }
                        }
                        if error == "" {
                            if record.state.copy() == 10 && type(record?.page_q) != "null" {
                                record.state = 4;
                            }
                            records[records.length] = record;
                            done_texts[done_texts.length] = done_text;
                        }
                    }
                }
            }
            if error == "" {
                if next.epoch_seq + records.length > max_epoch() {
                    error = "session:epoch_exhausted";
                } else {
                    let mut position = 0;
                    while position < records.length {
                        let record = records[position].copy();
                        let guid = record.guid.copy();
                        let mut tasks = next.tasks;
                        tasks[guid.copy()] = record;
                        next.tasks = tasks;
                        let mut order = next.order.copy();
                        let mut present = false;
                        for order_index in 0..order.length {
                            let existing: string = order[order_index].copy();
                            if existing == guid {
                                present = true;
                                break;
                            }
                        }
                        if present == false {
                            order[order.length] = guid.copy();
                        }
                        next.order = order;
                        next.queue = queue::push(next.queue.copy(), guid.copy());
                        let seq = next.epoch_seq.copy();
                        let mut epochs = next.epochs;
                        epochs[guid.copy()] = seq + 1;
                        next.epochs = epochs;
                        next.epoch_seq = seq + 1;
                        let mut scan_map = next.scan_done;
                        scan_map[guid.copy()] = done_texts[position].copy();
                        next.scan_done = scan_map;
                        position = position + 1;
                    }
                }
            }
        }
    }
    if error == "" && has_login == false && (&legacy_path).length > 0
        && legacy_present {
        let legacy_text = read_text(legacy_path.copy());
        let plan: LegacyPlan = json::decode::<LegacyPlan>(login::parse_legacy(legacy_text));
        if plan.ok.copy() {
            let member: string = plan.copy()?.member.unwrap_or("");
            let pass: string = plan.copy()?.pass.unwrap_or("");
            let mut legacy_cookies = cookies.copy();
            legacy_cookies = cookie_set(legacy_cookies, "ipb_member_id", member);
            legacy_cookies = cookie_set(legacy_cookies, "ipb_pass_hash", pass);
            let header_plan: CookieHeaderPlan = json::decode::<CookieHeaderPlan>(
                login::cookie_header(legacy_cookies.names.copy(), legacy_cookies.values.copy())
            );
            if header_plan.ok.copy() == false {
                error = "session:cookie_value_not_string";
            } else {
                legacy_cookies.header = header_plan.copy()?.header;
                cookies = legacy_cookies;
                has_login = true;
            }
        }
    }
    if error != "" => {
        session_step(store, false, error, null, null, false, false)
    } else => {
        next.cookies = cookies;
        next.has_login = has_login;
        session_step(next, true, "", err_no_error(), null, false, false)
    }
}

/// Report a host-side failure (malformed JSON, structural refusal, I/O) through
/// the normal report shape after the embedding converted the invocation error.
fn op_session_failed(store: Store, document: map) -> Step {
    let message = field_string(document.copy(), "message", "");
    let class = field_string(document.copy(), "class", "host_failure");
    let raw_code = field_int(document.copy(), "code", -1);
    let code: int? = if raw_code < 0 => {
        null
    } else => {
        raw_code
    };
    session_step(store, false, "session:" + class, code, message, false, false)
}


fn op_session_save(store: Store, _document: map) -> Step {
    session_save(store)
}

fn op_session_load(store: Store, _document: map) -> Step {
    session_load(store)
}

fn op_seed_queue(store: Store, document: map) -> Step {
    if store.allow_seed == false => {
        error_step(store, "seed_not_allowed")
    } else => {
        let guid = field_string(document.copy(), "guid", "");
        if store_has_task(store.copy(), guid.copy()) == false => {
            error_step(store, "unknown_task")
        } else => {
            let record: Task = task_of(store.copy(), guid.copy());
            let mut seeded = record.copy();
            if document.has("img_q") {
                let values: [string] = document["img_q"].copy();
                if values.length == 0 {
                    seeded.img_q = null;
                } else {
                    seeded.img_q = json::encode(values);
                }
            }
            if document.has("page_q") {
                let values: [string] = document["page_q"].copy();
                if values.length == 0 {
                    seeded.page_q = null;
                } else {
                    seeded.page_q = json::encode(values);
                }
            }
            ok_step(replace_task(store, seeded))
        }
    }
}

fn op_remaining_plan(store: Store, document: map) -> Step {
    let guid = field_string(document.copy(), "guid", "");
    if store_has_task(store.copy(), guid.copy()) == false => {
        error_step(store, "unknown_task")
    } else => {
        let record: Task = task_of(store.copy(), guid.copy());
        if type(record?.page_q) == "null" => {
            error_step(store, "no_remaining_queue")
        } else if record.meta.copy().has("total") == false
            || type(record.meta.copy()["total"].copy()) != "int" => {
            error_step(store, "plan:missing_total")
        } else if record.meta.copy().has("title") == false
            || type(record.meta.copy()["title"].copy()) != "string" => {
            error_step(store, "plan:missing_title")
        } else if record.config.copy().has("dir") == false
            || type(record.config.copy()["dir"].copy()) != "string" => {
            error_step(store, "plan:missing_dir")
        } else => {
            let total: int = record.meta.copy()["total"].copy();
            let title: string = record.meta.copy()["title"].copy();
            let dir: string = record.config.copy()["dir"].copy();
            let page_q: string = record?.page_q.unwrap_or("");
            let img_q = if type(record?.img_q) == "null" => {
                "[]"
            } else => {
                record?.img_q.unwrap_or("")
            };
            let done = if store.scan_done.has(guid.copy()) => {
                let text: string = store.scan_done[guid.copy()].copy();
                text
            } else => {
                "[]"
            };
            let plan_text = session::download_plan(
                page_q,
                img_q,
                json::encode(record.reload_map.copy()),
                done,
                total,
                dir,
                title
            );
            let plan: RemainingPlan = json::decode::<RemainingPlan>(plan_text);
            if plan.ok.copy() == false => {
                error_step(store, "plan:" + plan.copy()?.error.unwrap_or("invalid"))
            } else => {
                let mut step = ok_step(store);
                step.value = plan_text;
                step
            }
        }
    }
}

// ---- report ----------------------------------------------------------------

fn int_or_null(value: int?) -> string {
    if type(value) == "null" => {
        "null"
    } else => {
        json::encode(value.unwrap_or(0))
    }
}

fn string_or_null(value: string?) -> string {
    if type(value) == "null" => {
        "null"
    } else => {
        json::encode(value.unwrap_or(""))
    }
}

fn event_text(event: EventCheck?) -> string {
    if type(event) == "null" => {
        "null"
    } else => {
        let typed: EventCheck = event.unwrap_or({ accepted: false, reason: "" });
        "{\"accepted\":" + json::encode(typed.accepted)
            + ",\"reason\":" + json::encode(typed.reason) + "}"
    }
}

fn pending_text(pending: PendingEffect?) -> string {
    if type(pending) == "null" => {
        "null"
    } else => {
        let typed: PendingEffect = pending.unwrap_or({
            kind: "",
            guid: "",
            directory: "",
            title: "",
        });
        "{\"kind\":" + json::encode(typed.kind)
            + ",\"guid\":" + json::encode(typed.guid)
            + ",\"directory\":" + json::encode(typed.directory)
            + ",\"title\":" + json::encode(typed.title) + "}"
    }
}

fn presence_text(presence: map?) -> string {
    if type(presence) == "null" => {
        "null"
    } else => {
        let typed: map = presence.unwrap_or({});
        let proxy: bool = typed["proxy"].copy();
        let dir: bool = typed["dir"].copy();
        let ignored: bool = typed["ignored_errors"].copy();
        "{\"proxy\":" + json::encode(proxy)
            + ",\"dir\":" + json::encode(dir)
            + ",\"ignored_errors\":" + json::encode(ignored) + "}"
    }
}

fn session_text(session: SessionCheck?) -> string {
    if type(session) == "null" => {
        "null"
    } else => {
        let typed: SessionCheck = session.unwrap_or({
            code: null,
            value: null,
            error: "",
            committed: false,
            directory_synced: false,
        });
        "{\"code\":" + int_or_null(typed?.code)
            + ",\"value\":" + string_or_null(typed?.value)
            + ",\"error\":" + json::encode(typed.error)
            + ",\"committed\":" + json::encode(typed.committed)
            + ",\"directory_synced\":" + json::encode(typed.directory_synced) + "}"
    }
}

fn cookies_text(cookies: CookieState) -> string {
    let mut out = "[";
    for index in 0..cookies.names.length {
        let name: string = cookies.names[index].copy();
        if index > 0 {
            out = out + ",";
        }
        let value = if cookies.values.has(name) => {
            let text: string = cookies.values[name.copy()].copy();
            json::encode(text)
        } else => {
            "null"
        };
        out = out + "{\"name\":" + json::encode(name) + ",\"value\":" + value + "}";
    }
    out + "]"
}

fn build_report(
    store: Store,
    ok: bool,
    error: string,
    code: int?,
    value: string?,
    warnings: [string],
    event: EventCheck?,
    pending: PendingEffect?,
    presence: map?,
    session: SessionCheck?
) -> string {
    let head = "{\"ok\":" + json::encode(ok)
        + ",\"error\":" + json::encode(error)
        + ",\"code\":" + int_or_null(code)
        + ",\"value\":" + string_or_null(value)
        + ",\"warnings\":" + json::encode(warnings)
        + ",\"event\":" + event_text(event)
        + ",\"pending\":" + pending_text(pending)
        + ",\"presence\":" + presence_text(presence)
        + ",\"session\":" + session_text(session);
    let config_text = json::encode(store.config);
    let mut proxy_text = "null";
    if type(store?.proxy) != "null" {
        let proxy_state: map = store?.proxy.unwrap_or(pool::initial());
        proxy_text = json::encode(proxy_state);
    }
    let tasks_text = table_json(store.tasks, store.order);
    let queue_text = json::encode(store.queue);
    let epochs_text = json::encode(store.epochs);
    let completions_text = json::encode(store.completions);
    // Cookie plaintext is only exposed to trusted fixtures. Production
    // reports keep the login flag but do not publish the imported values.
    let expose_cookies = store.allow_seed.copy();
    let cookies_json = if expose_cookies => {
        let cookies = store.cookies.copy();
        cookies_text(cookies)
    } else => {
        "null"
    };
    let header_json = if expose_cookies => {
        let cookies = store.cookies.copy();
        string_or_null(cookies?.header)
    } else => {
        "null"
    };
    head + ",\"config\":" + config_text
        + ",\"proxy\":" + proxy_text
        + ",\"tasks\":" + tasks_text
        + ",\"queue\":" + queue_text
        + ",\"epochs\":" + epochs_text
        + ",\"completions\":" + completions_text
        + ",\"cookies\":" + cookies_json
        + ",\"cookie_header\":" + header_json
        + ",\"has_login\":" + json::encode(store.has_login)
        + "}"
}

fn finish(step: Step) -> Control {
    let store = step.store;
    let report = build_report(
        store.copy(),
        step.ok,
        step.error,
        step?.code,
        step?.value,
        step.warnings,
        step?.event,
        step?.pending,
        step?.presence,
        step?.session
    );
    { store: store, report: report }
}

pub fn create(guids: [string], epoch_start: int, allow_seed: bool) -> Control {
    let mut start = epoch_start;
    if start < 0 {
        start = 0;
    }
    {
        store: {
            config: types::defaults_data(),
            proxy: null,
            tasks: {},
            order: [],
            queue: [],
            epochs: {},
            completions: {},
            epoch_seq: start,
            has_login: false,
            guid_plan: guids,
            guid_cursor: 0,
            allow_seed: allow_seed,
            cookies: {
                names: ["nw"],
                values: { nw: "1" },
                header: null,
            },
            owner_nonce: xeh_system::uuid_v4(),
            scan_done: {},
        },
        report: "",
    }
}

pub fn report(control: Control) -> string {
    control.report
}

pub fn dispatch(control: Control, request: string) -> Control {
    let document: map = json::decode::<map>(request);
    let op = field_string(document.copy(), "op", "");
    let store = control.store;
    let step = if op == "add" => {
        op_add(store.copy(), document)
    } else if op == "del" => {
        op_del(store.copy(), document)
    } else if op == "pause" => {
        op_pause(store.copy(), document)
    } else if op == "resume" => {
        op_resume(store.copy(), document)
    } else if op == "update" => {
        op_update(store.copy(), document)
    } else if op == "prepare" => {
        op_prepare(store.copy(), document)
    } else if op == "proxy_add" => {
        op_proxy_add(store.copy(), document)
    } else if op == "proxy_select" => {
        op_proxy_select(store.copy(), document)
    } else if op == "proxy_not_good" => {
        op_proxy_not_good(store.copy(), document)
    } else if op == "proxy_trace" => {
        op_proxy_trace(store.copy(), document)
    } else if op == "proxy_has" => {
        op_proxy_has(store.copy(), document)
    } else if op == "proxy_glyph_read" => {
        op_proxy_glyph_read(store.copy(), document)
    } else if op == "proxy_glyph_publish" => {
        op_proxy_glyph_publish(store.copy(), document)
    } else if op == "proxy_request" => {
        op_proxy_request(store.copy(), document)
    } else if op == "event" => {
        op_event(store.copy(), document)
    } else if op == "snapshot" => {
        ok_step(store.copy())
    } else if op == "set_login" => {
        op_set_login(store.copy(), document)
    } else if op == "seed_state" => {
        op_seed_state(store.copy(), document)
    } else if op == "seed_meta" => {
        op_seed_meta(store.copy(), document)
    } else if op == "seed_queue" => {
        op_seed_queue(store.copy(), document)
    } else if op == "session_save" => {
        op_session_save(store.copy(), document)
    } else if op == "session_load" => {
        op_session_load(store.copy(), document)
    } else if op == "session_failed" => {
        op_session_failed(store.copy(), document)
    } else if op == "remaining_plan" => {
        op_remaining_plan(store.copy(), document)
    } else => {
        error_step(store.copy(), "unknown_op:" + op)
    };
    finish(step)
}
