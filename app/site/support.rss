}

fn nd_all() -> string {
    let classes = nd_digits();
    let mut combined = "";
    for value in 0..classes.length {
        combined = combined + classes[value].copy();
    }
    combined
}

fn ascii_digit(value: int) -> string {
    if value == 0 => { "0" }
    else if value == 1 => { "1" }
    else if value == 2 => { "2" }
    else if value == 3 => { "3" }
    else if value == 4 => { "4" }
    else if value == 5 => { "5" }
    else if value == 6 => { "6" }
    else if value == 7 => { "7" }
    else if value == 8 => { "8" }
    else => { "9" }
}

/// Maps captured `Nd` digit characters onto ASCII digits. Callers pass one
/// numeric token, never a title, URL or whole page.
pub fn ascii_digits(text: string) -> string {
    let classes = nd_digits();
    let mut output = text.copy();
    for value in 0..classes.length {
        let class: string = classes[value].copy();
        let pattern = "[" + class.copy() + "]";
        output = re::replace(pattern.copy(), output.copy(), ascii_digit(value));
    }
    output
}

pub fn decimal(text: string) -> int {
    let digits = scan("([0-9])", ascii_digits(text.copy()));
    let matches: [map] = digits["matches"].copy();
    let mut value = 0;
    for index in 0..matches.length {
        let item: map = matches[index].copy();
        let digit: string = item["matched"].copy();
        let number = if digit == "0" => { 0 }
            else if digit == "1" => { 1 }
            else if digit == "2" => { 2 }
            else if digit == "3" => { 3 }
            else if digit == "4" => { 4 }
            else if digit == "5" => { 5 }
            else if digit == "6" => { 6 }
            else if digit == "7" => { 7 }
            else if digit == "8" => { 8 }
            else => { 9 };
        value = value * 10 + number;
    }
    value
}

fn hex_digit(value: int) -> string {
    if value == 0 => { "0" }
    else if value == 1 => { "1" }
    else if value == 2 => { "2" }
    else if value == 3 => { "3" }
    else if value == 4 => { "4" }
    else if value == 5 => { "5" }
    else if value == 6 => { "6" }
    else if value == 7 => { "7" }
    else if value == 8 => { "8" }
    else if value == 9 => { "9" }
    else if value == 10 => { "a" }
    else if value == 11 => { "b" }
    else if value == 12 => { "c" }
    else if value == 13 => { "d" }
    else if value == 14 => { "e" }
    else => { "f" }
}

fn hex4(value: int) -> string {
    hex_digit(value / 4096)
        + hex_digit((value / 256) % 16)
        + hex_digit((value / 16) % 16)
        + hex_digit(value % 16)
}

fn unicode_scalar(value: int) -> map {
    let mut result: map = {};
    if value < 0 || value > 1114111 || (value >= 55296 && value <= 57343) {
        result["ok"] = false;
        result["exception"] = "ValueError";
        result["value"] = "";
    } else {
        let encoded = if value <= 65535 => {
            "\"\\u" + hex4(value) + "\""
        } else => {
            let offset = value - 65536;
            let high = 55296 + offset / 1024;
            let low = 56320 + offset % 1024;
            "\"\\u" + hex4(high) + "\\u" + hex4(low) + "\""
        };
        if xeh_json::is_valid(encoded.copy()) {
            result["ok"] = true;
            result["exception"] = "";
            result["value"] = json::decode::<string>(encoded.copy());
        } else {
            result["ok"] = false;
            result["exception"] = "ValueError";
            result["value"] = "";
        }
    }
    result
}

pub fn htmlescape(text: string) -> map {
    let pattern = "&(#?)(" + "[" + nd_all() + "]{1,5}" + "|\\w{1,8}|[a-z]+);";
    let scan_result = scan(pattern, text.copy());
    let matches: [map] = scan_result["matches"].copy();
    let tail: string = scan_result["tail"].copy();
    let mut output = "";
    let mut exception = "";
    for index in 0..matches.length {
        let item: map = matches[index].copy();
        let groups: [string] = item["groups"].copy();
        let marker: string = groups[0].copy();
        let entity: string = groups[1].copy();
        output = output + item["prefix"].copy();
        if marker == "#" {
            if first("^[0-9]+$", ascii_digits(entity.copy())).length == 0 {
                exception = "ValueError";
            } else {
                let decoded = unicode_scalar(decimal(entity.copy()));
                if decoded["ok"].copy() == false {
                    let decoded_exception: string = decoded["exception"].copy();
                    exception = decoded_exception;
                } else {
                    output = output + decoded["value"].copy();
                }
            }
        } else if entity == "amp" {
            output = output + "&";
        } else if entity == "nbsp" {
            output = output + " ";
        } else if entity == "quot" {
            output = output + "\"";
        } else if entity == "lt" {
            output = output + "<";
        } else if entity == "gt" {
            output = output + ">";
        } else if entity == "copy" {
            output = output + "©";
        } else if entity == "reg" {
            output = output + "®";
        } else {
            output = output + "?";
        }
        if exception != "" {
            break;
        }
    }
    let mut result: map = {};
    if exception != "" {
        result["ok"] = false;
        result["exception"] = exception;
        result["text"] = "";
    } else {
        result["ok"] = true;
        result["exception"] = "";
        result["text"] = output + tail;
    }
    result
}

pub fn parse_human_time(text: string) -> int {
    let digits = "([" + nd_all() + "]+)";
    let days = first(digits.copy() + "\\sdays*", text.copy());
    let hours = first(digits.copy() + "\\shours*", text.copy());
    let minutes = first(digits.copy() + "\\sminutes*", text.copy());
    let mut seconds = 0;
    if days.length > 1 {
        seconds = seconds + 86400 * decimal(days[1].copy());
    }
    if hours.length > 1 {
        seconds = seconds + 3600 * decimal(hours[1].copy());
    }
    if minutes.length > 1 {
        seconds = seconds + 60 * decimal(minutes[1].copy());
    } else {
        seconds = seconds + 60;
    }
    seconds
}
