//! Regex composition and one-pass text helpers used by the RSS site filters.
use json;
use re;
use xeh_json;

fn scan(pattern: string, text: string) -> map {
    let nul = json::decode::<string>("\"\\u0000\"");
    let soh = json::decode::<string>("\"\\u0001\"");
    let mut nul_run = nul.copy();
    let mut delimiter = nul_run.copy() + soh.copy();
    while string_contains(text.copy(), delimiter.copy()) {
        nul_run = nul_run.copy() + nul_run.copy();
        delimiter = nul_run.copy() + soh.copy();
    }
    let marked = re::replace(pattern.copy(), text.copy(), "$0" + delimiter.copy());
    let pieces = string_split_literal(marked.copy(), delimiter.copy());
    let combined_pattern = "(?s)^(.*)(" + pattern.copy() + ")$";
    let mut matches: [map] = [];
    let mut tail = "";
    if pieces.length > 0 {
        for index in 0..(pieces.length - 1) {
            let segment: string = pieces[index].copy();
            let captures = re::captures(combined_pattern.copy(), segment.copy());
            if captures.length > 2 {
                let mut groups: [string] = [];
                for group_index in 3..captures.length {
                    groups[groups.length] = captures[group_index].copy();
                }
                let mut item: map = {};
                item["prefix"] = captures[1].copy();
                item["matched"] = captures[2].copy();
                item["groups"] = groups;
                matches[matches.length] = item;
            }
        }
        let last_piece: string = pieces[pieces.length - 1].copy();
        tail = last_piece;
    }
    let mut output: map = {};
    output["matches"] = matches;
    output["tail"] = tail;
    output
}

pub fn capture_all(pattern: string, text: string) -> [string] {
    capture_group_all(pattern.copy(), text.copy(), 0)
}

pub fn capture_group_all(pattern: string, text: string, group_index: int) -> [string] {
    let scanned = scan(pattern.copy(), text.copy());
    let mut output: [string] = [];
    let matches: [map] = scanned["matches"].copy();
    for index in 0..matches.length {
        let item: map = matches[index].copy();
        let groups: [string] = item["groups"].copy();
        if group_index >= 0 && group_index < groups.length {
            output[output.length] = groups[group_index].copy();
        }
    }
    output
}

pub fn first(pattern: string, text: string) -> [string] {
    re::captures(pattern.copy(), text.copy())
}

