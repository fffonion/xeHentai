use bytes;
use http;

// Update check decision and log selection (`updater/updater.py:21-63`).
//
// This module owns the mode decision (off/check/download), the same-update-id
// comparison, what gets logged for each outcome, and the buffered commits
// request. The Rust owner supplies the typed binding/request plan from
// `github.rss`, the transport policy, the owned background task and the logger
// sink. No download, pending file, package or apply decision exists in this
// scope: a `download` run reports the explicit unsupported stage instead of
// claiming a completed update.

struct LogEvent {
    level: string,
    key: string,
    args: [string],
}

struct ModeDecision {
    outcome: string,
    exception: string?,
}

struct FetchResult {
    status: int,
    url: string,
    body: string,
}

struct CheckDecision {
    outcome: string,
    events: [LogEvent],
}

fn mode_error() -> string {
    "unknown auto update mode"
}

pub fn upd_mode(mode: string) -> ModeDecision {
    let mut outcome = "invalid";
    let mut exception: string? = null;
    if mode == "off" {
        outcome = "off";
    } else if mode == "check" {
        outcome = "check";
    } else if mode == "download" {
        outcome = "download";
    } else {
        exception = mode_error();
    }
    let decision = {
        outcome: outcome,
        exception: exception,
    };
    decision
}

/// Perform the commits request inside the sandboxed HTTP host. A transport
/// failure is a VM error surfaced by the Rust owner; a completed response is
/// returned with its status, final URL and decoded text for `github.rss`.
pub fn upd_fetch(url: string, headers: [[string]]) -> FetchResult {
    let mut request = http::request::new("GET", url);
    for index in 0..headers.length {
        let pair = &headers[index];
        http::request::set_header(&mut request, pair[0], pair[1]);
    }
    let response = http::client::request(request);
    let final_url = http::response::url(&response);
    let body = bytes::to_utf8(http::response::body(&response));
    let result = {
        status: http::response::status(&response),
        url: final_url,
        body: body,
    };
    result
}

fn event(level: string, key: string, args: [string]) -> LogEvent {
    let entry = {
        level: level,
        key: key,
        args: args,
    };
    entry
}

fn available_events(ts: string, message: string, update_id: string) -> [LogEvent] {
    let mut events: [LogEvent] = [];
    events[events.length] = event("info", "UPDATE_AVAILABLE", [ts, message, update_id]);
    events
}

/// The check decision. `applied_update_id` is the update id of the currently
/// loaded build (empty for this un-updated build); it is an ordinary input and
/// the only source of the same-id decision.
pub fn upd_decide(
    mode: string,
    applied_update_id: string,
    update_id: string,
    ts: string,
    message: string
) -> CheckDecision {
    let mut outcome = "invalid";
    let mut events: [LogEvent] = [];
    if applied_update_id.length > 0 && applied_update_id == update_id {
        outcome = "up_to_date";
        events[events.length] = event("debug", "UPDATE_NO_UPDATE", []);
    } else if mode == "check" || mode == "off" {
        // `off` is reached only by a DIRECT legacy `check_update` call: the CLI
        // caller suppresses the whole module for `off`, so a direct check still
        // asks the source and prints the manual-download hint (oracle
        // u2_off_stable_diff), exactly like `check`.
        outcome = "available";
        events = available_events(ts, message, update_id);
        events[events.length] = event("info", "UPDATE_DOWNLOAD_MANUALLY", []);
    } else if mode == "download" {
        // The check half is complete; the package/download/apply half is the
        // following scope and must not be reported as a completed update.
        outcome = "download_unsupported";
        events = available_events(ts, message, update_id);
        events[events.length] = event("warning", "UPDATE_DOWNLOAD_UNSUPPORTED", ["this build implements the update check only; no package was downloaded"]);
    } else {
        outcome = "invalid";
    }
    let decision = {
        outcome: outcome,
        events: events,
    };
    decision
}

/// Failure logging selected by this module; the Rust owner renders the typed
/// event through the existing App logger.
pub fn upd_failure(detail: string) -> CheckDecision {
    let mut events: [LogEvent] = [];
    events[events.length] = event("warning", "UPDATE_FAILED", [detail]);
    let decision = {
        outcome: "failed",
        events: events,
    };
    decision
}
