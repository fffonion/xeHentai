use json;

// Page filters from the fixed Python reference (`xeHentai/filters.py:15-268`).
//
// Every branch below is a direct migration of the reference function. Native
// Rust supplies the response view, the regex/JSON primitives and the Task/file
// side effects named by the returned result; it does not pre-parse pages.

